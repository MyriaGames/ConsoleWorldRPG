<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>App.ico</ApplicationIcon>
    <Version>0.2.0</Version>
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <FileVersion>0.2.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Myria.Lib\Myria.Lib.Core\Myria.Lib.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.11" />
  </ItemGroup>

  <!-- Game data — linked directly from Myria.Lib.Core's Data/common, the single source of
       truth (mirrors Myria.Wpf's csproj). Console previously kept its own physically duplicated
       copies of these files, which had drifted out of sync (e.g. 56 rooms vs. Lib's 87) and was
       also missing effects.json/loot_tables.json/starting_items.json entirely. Linking instead
       of copying makes that drift structurally impossible going forward. -->
  <ItemGroup>
    <Content Include="..\Myria.Lib\Myria.Lib.Core\Data\common\**\*.json" LinkBase="Data\common\" Exclude="..\Myria.Lib\Myria.Lib.Core\Data\common\base_runes.json;..\Myria.Lib\Myria.Lib.Core\Data\common\rune_families.json;..\Myria.Lib\Myria.Lib.Core\Data\common\rune_word_pairs.json;..\Myria.Lib\Myria.Lib.Core\Data\common\rune_words.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Shared base locale strings — linked from Myria.Lib.Core, same as Data/common above.
       Localization.Load() reads these first, then merges console's own Data/misc/locales/
       additions (registered via RegisterAdditionalLocaleDirectory in Services/GameService.cs)
       on top. -->
  <ItemGroup>
    <Content Include="..\Myria.Lib\Myria.Lib.Core\Data\locales\**\*.json" LinkBase="Data\locales\">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Console-only UI string additions — merged on top of the shared base above. -->
  <ItemGroup>
    <Content Include="Data\misc\locales\de.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Data\misc\locales\en.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Game data — deployed to Data/common/ to match Myria.Lib.Core's default paths -->

  <!-- Maps — kept at Data/Maps/ so area entities (MapFile property) can reference them unchanged -->
  <ItemGroup>
    <Content Include="Data\Maps\city_lumina_map.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Data\Maps\city_of_ceralith_map.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Data\Maps\city_of_elorium_map.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Data\Maps\whispering_woods_map.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Data\Maps\world_map.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Data\Maps\hollow_crypt_map.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Data\Maps\luminas_caves_map.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
